{
  "name": "gd-organizer",
  "productName": "GD Organizer",
  "version": "0.1.0",
  "description": "GD Organizer - Geometry Dash Launcher & Mod Manager",
  "author": "drmilooo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.drmilooo.gdorganizer",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "GD Organizer"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!build/*"
    ]
  }
}
